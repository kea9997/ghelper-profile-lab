{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghelper-profile-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "SERVICE_ORIGIN": "https://ghelper.optiwork.co.kr",
    "RELEASE_URL": "https://github.com/kea9997/ghelper-profile-lab/releases/latest"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghelper-profiles",
      // Fill this with the authorized D1 database ID before deployment.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
  // Configure the intended zone/custom domain only after account review.
  // "routes": [{"pattern":"ghelper.optiwork.co.kr","custom_domain":true}]
}
